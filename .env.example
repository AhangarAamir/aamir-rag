OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
# recursive = default splitter; metadata agent tags uniqueness after the cut
# agentic = LLM decides clause/section cuts (slow)
# document = split on paragraphs/sections
CHUNKING_STRATEGY=recursive
METADATA_BATCH_SIZE=4
DOCUMENT_CARD_CHARS=12000
QUERY_SESSION_ID=legal-query-default
NUM_HISTORY_RUNS=5
