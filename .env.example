# openai uses the OpenAI Responses API.
# openailike, ollama, litellm, and vllm use an OpenAI-compatible chat endpoint.
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
# Required for openailike / ollama / litellm / vllm. Example: http://127.0.0.1:11434/v1
OPENAI_BASE_URL=
# ollama | litellm | vllm. Ollama also turns thinking off. Leave empty to infer from the URL.
OPENAI_LIKE_BACKEND=
# Merged into compatible chat requests. Ollama reads num_ctx and num_batch from options.
OPENAI_LIKE_OPTIONS={"num_ctx": 32768, "num_batch": 2048}
# Seconds for chat and embedding requests. Applies to OpenAI, vLLM, Ollama, and LiteLLM.
REQUEST_TIMEOUT_SECONDS=300
# openai | openailike | ollama | litellm | vllm | huggingface.
# Empty follows LLM_PROVIDER. Hugging Face loads the model locally on CPU.
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=text-embedding-3-large
# Ollama example:
# EMBEDDING_PROVIDER=ollama
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_BASE_URL=http://127.0.0.1:11434
# EMBEDDING_DIMENSIONS=768
# Hugging Face examples (needs `uv add sentence-transformers`).
# The model is saved under data/models and reused on later runs.
# EMBEDDING_PROVIDER=huggingface
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS=384
# EMBEDDING_MODEL=Alibaba-NLP/gte-base-en-v1.5
# EMBEDDING_DIMENSIONS=768
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=
# agentic = legal custom chunker (inner agent + metadata + session summary)
# document = split on paragraphs/sections
# recursive = fallback splitter
CHUNKING_STRATEGY=agentic
CHUNKING_MAX_SIZE=4000
# Parallel metadata labeling (agent.arun). Set false for old sequential window walk.
CHUNKER_ASYNC=true
CHUNKER_CONCURRENCY=8
SEARCH_MAX_RESULTS=12
QUERY_SESSION_ID=legal-query-default
NUM_HISTORY_RUNS=5
HOST=127.0.0.1
PORT=8000
# Comma-separated browser origins. Bare hostnames are treated as https://.
CORS_ALLOWED_ORIGINS=https://uracs.enp.ril.com,https://uracs.ucg.ril.com
# Custom observability dashboard (SQLite traces + /observability UI)
OBS_APP=legal-rag
# Set true to also record inner chunker / topic-shift agent runs
OBS_TRACE_INNER=false
# Optional USD / 1M overrides if the catalog is wrong for your model
# OBS_INPUT_USD_PER_M=0.20
# OBS_CACHED_USD_PER_M=0.02
# OBS_OUTPUT_USD_PER_M=1.20
# OBS_PRICES_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
