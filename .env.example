# ---- OpenAI models (chat on the Responses API, embeddings on /v1/embeddings).
# Always https://api.openai.com/v1; OPENAI_BASE_URL is ignored.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-5.6-luna
# none | minimal | low | medium | high | xhigh. Empty = model default.
OPENAI_REASONING_EFFORT=
EMBEDDING_MODEL=text-embedding-3-large
EMBED_ENABLED=true
EMBED_BATCH_SIZE=64
# One call per document at ingest (title, parties, block, date, status). Empty = OPENAI_MODEL.
INGEST_MODEL=
INGEST_LLM_PROFILE=true
INGEST_WORKERS=1

# ---- Corpus and storage. Index: data/index.db
# CORPUS_DIR=data/incoming
# DATA_DIR=data

# ---- documents.link / References (rules from the old query prompt).
# Set both empty to link to the local file served at /files/.
DOC_CENTER_BASE_URL=https://enp1.ril.com/sites/Regulatory/Document%20Center
SITES_BASE_URL=https://enp1.ril.com

# ---- Retrieval / agent tuning
SEARCH_TOP_K=8
CHUNK_MAX_CHARS=2400
NUM_HISTORY_RUNS=4
TOOL_CALL_LIMIT=18
QUERY_SESSION_ID=legal-query-default

# ---- Server
HOST=127.0.0.1
PORT=8000
# Comma-separated browser origins. Bare hostnames are treated as https://.
CORS_ALLOWED_ORIGINS=https://uracs.enp.ril.com,https://uracs.ucg.ril.com

# ---- Observability dashboard (SQLite traces + /observability UI)
OBS_APP=legal-rag
OBS_TRACE_INNER=false
# Optional USD / 1M overrides if the catalog is wrong for your model
# OBS_INPUT_USD_PER_M=0.20
# OBS_CACHED_USD_PER_M=0.02
# OBS_OUTPUT_USD_PER_M=1.20
# OBS_PRICES_URL=https://raw.githubusercontent.com/BerriAI/litellm/main/model_prices_and_context_window.json
